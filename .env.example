# --- External MySQL (your existing AwardSpace database) ---
DB_HOST=your-awardspace-mysql-host
DB_PORT=3306
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=your_db_name
DB_SSL=false

# --- Auth ---
# openssl rand -hex 32
SECRET_KEY=generate-64-random-hex-chars-here

# --- Email (Gmail SMTP, same credentials PHPMailer used) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password

# --- Cron protection ---
# openssl rand -hex 24
CRON_SECRET=generate-a-random-secret-here

SITE_URL=https://yourdomain.com
